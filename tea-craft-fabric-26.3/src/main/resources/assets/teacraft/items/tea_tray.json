{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:custom_model_data",
      "scale": 1,
      "fallback": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_icon_0" },
      "entries": [
          {
            "threshold": 1,
            "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_icon_1" }
          },
          {
            "threshold": 2,
            "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_icon_2" }
          },
          {
            "threshold": 3,
            "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_icon_3" }
          }
      ]
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "fallback": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_0" },
      "entries": [
        {
          "threshold": 0.5,
          "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_1" }
        },
        {
          "threshold": 1,
          "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_2" }
        },
        {
          "threshold": 1.5,
          "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_3" }
        },
        {
          "threshold": 2,
          "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_4" }
        },
        {
          "threshold": 2.5,
          "model": { "type": "minecraft:model", "model": "teacraft:item/tea_tray_shake_5" }
        }
      ]
    }
  }
}