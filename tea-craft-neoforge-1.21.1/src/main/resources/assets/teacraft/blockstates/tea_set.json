{
  "multipart": [
    { "apply": { "model": "teacraft:block/tea_set/tray" } },
    { "when": { "facing": "north" }, "apply": { "model": "teacraft:block/tea_set/slots_north" } },
    { "when": { "facing": "east" }, "apply": { "model": "teacraft:block/tea_set/slots_east" } },
    { "when": { "facing": "south" }, "apply": { "model": "teacraft:block/tea_set/slots_south" } },
    { "when": { "facing": "west" }, "apply": { "model": "teacraft:block/tea_set/slots_west" } },
    { "when": { "AND": [ { "gaiwan": "true" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/gaiwan" } },
    { "when": { "AND": [ { "gaiwan": "true" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/gaiwan_east" } },
    { "when": { "AND": [ { "gaiwan": "true" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/gaiwan_south" } },
    { "when": { "AND": [ { "gaiwan": "true" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/gaiwan_west" } },
    { "when": { "AND": [ { "cup_a": "empty" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_empty" } },
    { "when": { "AND": [ { "cup_a": "empty" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_empty_east" } },
    { "when": { "AND": [ { "cup_a": "empty" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_empty_south" } },
    { "when": { "AND": [ { "cup_a": "empty" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_empty_west" } },
    { "when": { "AND": [ { "cup_a": "full" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_full" } },
    { "when": { "AND": [ { "cup_a": "full" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_full_east" } },
    { "when": { "AND": [ { "cup_a": "full" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_full_south" } },
    { "when": { "AND": [ { "cup_a": "full" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_a_full_west" } },
    { "when": { "AND": [ { "cup_b": "empty" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_empty" } },
    { "when": { "AND": [ { "cup_b": "empty" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_empty_east" } },
    { "when": { "AND": [ { "cup_b": "empty" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_empty_south" } },
    { "when": { "AND": [ { "cup_b": "empty" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_empty_west" } },
    { "when": { "AND": [ { "cup_b": "full" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_full" } },
    { "when": { "AND": [ { "cup_b": "full" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_full_east" } },
    { "when": { "AND": [ { "cup_b": "full" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_full_south" } },
    { "when": { "AND": [ { "cup_b": "full" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_b_full_west" } },
    { "when": { "AND": [ { "cup_c": "empty" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_empty" } },
    { "when": { "AND": [ { "cup_c": "empty" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_empty_east" } },
    { "when": { "AND": [ { "cup_c": "empty" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_empty_south" } },
    { "when": { "AND": [ { "cup_c": "empty" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_empty_west" } },
    { "when": { "AND": [ { "cup_c": "full" }, { "facing": "north" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_full" } },
    { "when": { "AND": [ { "cup_c": "full" }, { "facing": "east" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_full_east" } },
    { "when": { "AND": [ { "cup_c": "full" }, { "facing": "south" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_full_south" } },
    { "when": { "AND": [ { "cup_c": "full" }, { "facing": "west" } ] }, "apply": { "model": "teacraft:block/tea_set/cup_c_full_west" } }
  ]
}
